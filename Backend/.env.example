# Server
PORT=8000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/hiresense

# JWT (generate long random strings; do not reuse these examples)
ACCESS_TOKEN_SECRET=replace_with_a_long_random_string
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace_with_another_long_random_string
REFRESH_TOKEN_EXPIRY=7d
JWT_SECRET=replace_with_a_long_random_string

# Models
# Live interview and CV analysis use Gemini today.
GEMINI_API_KEY=
# Scoring agent (Backend/agent) uses OpenAI function calling when this is set.
# If it is empty, the agent uses the deterministic fallback scorer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Redis (BullMQ). Required for docker compose and for queued scoring.
# Leave REDIS_URL empty, or set QUEUE_INLINE=true, to score inside the API process.
REDIS_URL=redis://127.0.0.1:6379
QUEUE_INLINE=true

# Delete the local recording file after a successful score. Path must be under public/temp.
PURGE_RECORDINGS=false

# Cloudinary (optional media upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail (optional; the mail helper is not mounted on a route)
MAIL_USER=
MAIL_PASSWORD=

# Khalti (optional payments)
KHALTI_SECRET_KEY=
